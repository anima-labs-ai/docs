					},
					{
						"group": "Resources",
						"icon": "book-open",
						"pages": ["examples", "faq"]
					},
					{
						"group": "Legal",
						"icon": "scale",
						"pages": [
							"legal/terms-of-service",
							"legal/privacy-policy",
							"legal/data-processing-agreement"
						]
					},
					{
						"group": "Blog",
						"icon": "newspaper",
						"pages": [
							"blog/introducing-anima",
							"blog/anima-vs-agentmail",
							"blog/agent-identity-did",
							"blog/give-agent-phone-number",
