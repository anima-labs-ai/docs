{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "mint",
	"name": "Anima",
	"description": "Unified identity infrastructure for AI agents — email, phone, voice, vault, and agent-to-agent commerce.",
	"colors": {
		"primary": "#16a34a",
		"light": "#22c55e",
		"dark": "#16a34a"
	},
	"logo": "/logo.png",
	"favicon": "/favicon.png",
	"icons": {
		"library": "lucide"
	},
	"navbar": {
		"links": [
			{ "label": "useanima.sh", "href": "https://useanima.sh" },
			{ "label": "Changelog", "href": "https://useanima.sh/changelog" }
		],
		"primary": {
			"type": "button",
			"label": "Open Console",
			"href": "https://console.useanima.sh"
		}
	},
	"contextual": {
		"options": ["copy", "view", "claude", "cursor", "vscode", "mcp", "chatgpt"]
	},
	"footer": {
		"socials": {
			"github": "https://github.com/anima-labs-ai",
			"x": "https://x.com/UseAnimaSh"
		}
	},
	"redirects": [
		{ "source": "/docs/:slug*", "destination": "/:slug*" },
		{ "source": "/protocols/index", "destination": "/protocols/overview" },
		{ "source": "/coding-agents", "destination": "/integrations" }
	],
	"navigation": {
		"tabs": [
			{
				"tab": "Documentation",
				"groups": [
					{
						"group": "Getting Started",
						"icon": "rocket",
						"pages": [
							"getting-started",
							"ai-agents",
							"integrations",
							"install",
							"quickstart-email",
							"quickstart-voice",
							"quickstart-vault",
							"sdks"
						]
					},
					{
						"group": "Platform",
						"icon": "layers",
						"pages": [
							"vault",
							"secret-ref",
							"phone",
							"conversational-calls",
							"voice-catalog",
							"call-intelligence",
							"custom-domains",
							"mcp",
							"pricing-and-limits",
							"webhooks"
						]
					},
					{
						"group": "Agent Identity & Commerce",
						"icon": "fingerprint",
						"pages": [
							{
								"group": "Agent Identity",
								"pages": [
									"identity/did-method",
									"identity/verifiable-credentials",
									"identity/agent-cards"
								]
							},
							{
								"group": "Agent Registry",
								"pages": ["registry/overview"]
							},
							{
								"group": "Agent Wallet",
								"pages": ["wallet/overview"]
							},
							{
								"group": "Multi-Tenancy Pods",
								"pages": ["pods/overview"]
							},
							{
								"group": "A2A Protocol",
								"pages": ["a2a/overview"]
							}
						]
					},
					{
						"group": "Security",
						"icon": "shield",
						"pages": [
							"security",
							"encryption",
							{
								"group": "Security Operations",
								"pages": ["security/audit-log", "security/anomaly-detection"]
							}
						]
					},
					{
						"group": "Compliance",
						"icon": "clipboard-check",
						"pages": ["compliance/soc2-controls", "compliance/reporting"]
					},
					{
						"group": "Protocols",
						"icon": "network",
						"pages": [
							"protocols/overview",
							"protocols/visa-tap",
							"protocols/ap2",
							"protocols/mastercard-vi",
							"protocols/voice-websocket"
